---
import Layout from "@layouts/Layout.astro";
import { dateLong } from "@utils/date";

interface Props {
	title: string;
	description?: string;
	minutes: number;
	published: string | Date;
	updated?: string | Date;
	categories?: string[];
}

const { title, description, minutes, published, updated, categories } = Astro.props;
---

<Layout title={title} description={description}>
	<article class="prose prose-sm dark:prose-invert slide-enter-content">
		<h2>{title}</h2>
		<p class="text-xs text-muted">
			{dateLong(updated || published)} · {minutes} min read {
				categories && <> · {categories.join(" · ")}</>
			}
		</p>
		<hr />

		<slot />
	</article>
</Layout>

<script>
	// Allow only one details element to be open at a time within the same group
	const detailsElements = document.querySelectorAll("details[data-group]");
	detailsElements.forEach((currDetailsEl) => {
		const summary = currDetailsEl.querySelector("summary");
		const group = currDetailsEl.getAttribute("data-group");

		summary?.addEventListener("click", () => {
			for (const el of detailsElements) {
				if (el === currDetailsEl) continue;

				if (el.getAttribute("data-group") === group) {
					el.removeAttribute("open");
				}
			}
		});
	});
</script>

<style is:global>
	/* Style inline code */
	.prose code {
		color: var(--fg-deep);
		font-weight: normal;
		background-color: #aaaaaa18;
		border-radius: 0.25rem;
		padding: 0.2em;
	}
	.prose code::before,
	.prose code::after {
		content: "";
	}

	/* Remove background and padding from code blocks */
	.prose pre code {
		background-color: transparent;
		padding: 0;
	}

	/* Style code blocks */
	.prose pre {
		@apply bg-inset! border border-rule rounded-none;
	}

	/* Style code titles */
	.prose [data-remark-code-title] {
		@apply bg-inset! border border-rule border-b-none p-1 text-xs text-muted;
		@apply flex items-center justify-between;
	}
	.prose [data-remark-code-title] + pre {
		@apply m-0!;
	}
	.prose [data-remark-code-title]::before {
		content: attr(data-language);
		@apply text-muted/70 uppercase;
	}

	/* Code copy button styles */
	pre:has(code) {
		@apply relative;
	}

	pre button.copy {
		@apply absolute right-1 top-1;
		@apply size-6 rd-2;
		@apply hover:bg-dark/5 dark:hover:bg-light/5;

		& span {
			@apply absolute top-1/2 left-1/2 translate--50% opacity-60;
			@apply w-full h-full aspect-ratio-square;
		}

		& .ready {
			@apply i-ri-file-copy-line;
		}

		& .success {
			@apply opacity-0 bg-green-300! i-ri-check-line;
		}

		&.copied {
			& .success {
				@apply opacity-60;
			}

			& .ready {
				@apply opacity-0;
			}
		}
	}

	/* Style giscus discussions */
	.giscus-frame {
		@apply outline-none my-8;
	}
</style>
