---
import Head from "@components/Head.astro";
import "@/styles.css";
import Header from "@components/Header.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { COPYRIGHT } from "@utils/constants";

interface Props {
	title?: string;
	description?: string;
	class?: string;
}

const { title, description, class: className } = Astro.props as Props;

const isHome = Astro.url.pathname === "/";
---

<html lang="en">
	<Head {title} {description} />

	<body>
		<Header class="mb-10" />
		{!isHome && <Breadcrumbs />}

		<main id="main-content" class="slide-enter-content" class:list={[className]}>
			<slot />
		</main>

		<hr class="mt-20 mb-5" />

		<footer class="text-xs text-muted flex justify-between">
			<span>Set in <span class="text-fg">JetBrains Mono</span></span>
			<span>{COPYRIGHT}</span>
		</footer>
	</body>
</html>
