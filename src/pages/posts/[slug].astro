---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import MDLayout from "@layouts/MDLayout.astro";

export const getStaticPaths = (async () => {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutes = Math.round(remarkPluginFrontmatter.minutes || 0);
---

<MDLayout
	title={post.data.title}
	description={post.data.description}
	minutes={minutes}
	published={post.data.published}
	updated={post.data.updated}
	categories={post.data.categories}
>
	<Content />

	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo="amrbashir/amrbashir.me"
		data-repo-id="R_kgDOMKJUBw"
		data-category="Announcements"
		data-category-id="DIC_kwDOMKJUB84C1YXr"
		data-mapping="title"
		data-strict="1"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="top"
		data-theme="transparent_dark"
		data-lang="en"
		data-loading="lazy"
		crossorigin="anonymous"
		async></script>
</MDLayout>

<script>
	const progress = document.createElement("div");
	progress.id = "reading-progress";
	progress.setAttribute("aria-hidden", "true");
	document.body.appendChild(progress);

	function updateReadingProgress() {
		if (!progress) return;

		const scroller = document.scrollingElement || document.documentElement;
		const readableDistance = scroller.scrollHeight - scroller.clientHeight;
		const rawProgress = readableDistance <= 0 ? 1 : scroller.scrollTop / readableDistance;
		const progressValue = Math.min(Math.max(rawProgress, 0), 1);

		progress.style.width = `${progressValue * 100}%`;
	}

	function requestReadingProgressUpdate() {
		requestAnimationFrame(updateReadingProgress);
	}

	updateReadingProgress();
	window.addEventListener("scroll", requestReadingProgressUpdate, { passive: true });
	window.addEventListener("resize", requestReadingProgressUpdate);
</script>

<style is:global>
	#reading-progress {
		@apply fixed top-0 left-0 z-50 h-1px bg-accent;
		width: 0;
	}
	.slide-enter-content > #reading-progress {
		animation: none;
	}
</style>
