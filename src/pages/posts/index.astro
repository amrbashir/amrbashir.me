---
import DraftPost from "@components/DraftPost.astro";
import Post from "@components/Post.astro";
import Section from "@components/Section.astro";
import Layout from "@layouts/Layout.astro";
import { getSortedPosts } from "@utils/posts";

const sortedPosts = await getSortedPosts();
const postsByYear = Object.groupBy(sortedPosts, (post) =>
	new Date(post.post.data.updated || post.post.data.published).getFullYear(),
);
type PostsByYearEntry = [string, NonNullable<(typeof postsByYear)[number]>];
const sortedPostsByYear = Object.entries(postsByYear)
	.sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
	.filter((entry): entry is PostsByYearEntry => entry[1] !== undefined);
---

<Layout title="posts" description="A collection of blog posts by Amr Bashir.">
	<h1 class="text-2xl mt-5 mb-2">posts</h1>
	<p class="text-muted text-xs">
		<span class="text-fg">{sortedPosts.length}</span> published · also on <a
			href="/rss.xml"
			class="text-fg">/rss.xml</a
		>

		<hr class="my-5" />

		{
			sortedPostsByYear.map(([year, posts]) => (
				<Section title={year} subtitle={`${posts.length} post`}>
					<ul>
						{posts.map((post) => (
							<Post {...post} />
						))}
						{sortedPosts.length < 5 && <DraftPost />}
					</ul>
				</Section>
			))
		}
	</p>
</Layout>
