---
import Logo from "@public/logo.svg";
import ThemeToggle from "./ThemeToggle.astro";
import { AUTHOR, AUTHOR_LOCATION, AUTHOR_ROLE } from "@utils/constants";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const isHome = Astro.url.pathname === "/";
const projectsHref = isHome ? "#projects" : "/#projects";
const postsHref = isHome ? "#posts" : "/posts";
---

<header
	class="grid grid-cols-[auto_1fr_auto] grid-rows-[auto_auto] gap-x-2 items-center"
	class:list={[className]}
>
	<a href="/" class="row-span-2 hover:text-accent hover:border-transparent"
		><Logo class="h-10 w-6" />
	</a>

	<h1 class="font-semibold col-span-2">{AUTHOR}</h1>
	<p class="text-muted text-xs">{AUTHOR_ROLE} · {AUTHOR_LOCATION}</p>

	<nav class="flex items-center gap-x-2 text-xs">
		<a href="/cv">cv</a>
		<span class="text-muted"> · </span>
		<a href={projectsHref}>projects</a>
		<span class="text-muted"> · </span>
		<a href={postsHref}>posts</a>
		<span class="text-muted"> · </span>
		<ThemeToggle />
	</nav>
</header>
