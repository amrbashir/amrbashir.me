---
import type projects from "@data/projects.json";

type Props = (typeof projects)[number];

const { name, tags, url, homeShort } = Astro.props;
---

<li
	class="border-b border-rule last:border-0 py-4 grid grid-cols-[auto_1fr_auto] gap-4 items-center"
>
	<h3 class="text-sm">{name}</h3>
	<p class="text-xs text-faint">{tags.join(" · ")}</p>
	<a href={url} class="text-xs" target="_blank" rel="noopener">
		github <span class="i-ri-arrow-right-line size-3"></span>
	</a>
	<p class="text-xs text-muted col-span-2">{homeShort}</p>
</li>
